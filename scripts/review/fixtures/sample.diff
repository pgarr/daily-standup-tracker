+interface StandupEntry {
+  mood: number;
+  blockers: string[];
+}
+
+/** Average mood score across today's standup entries. */
+export function averageMood(entries: StandupEntry[]): number {
+  const total = entries.reduce((sum, entry) => sum + entry.mood, 0);
+  return total / entries.length;
+}
+
+/** Entries that reported at least one blocker. */
+export function blockedEntries(entries: StandupEntry[]): StandupEntry[] {
+  return entries.filter((entry) => entry.blockers.length > 0);
+}
